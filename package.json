{
  "name": "card-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone Vue 3 game card generator SPA. Create, edit, preview and export printable game cards entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:pages": "vue-tsc --noEmit && vite build --base=/card-generator/",
    "deploy": "npm run build:pages && node scripts/create-pages-fallback.mjs && gh-pages -d dist --dotfiles",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
